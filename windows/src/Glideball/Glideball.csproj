<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app: low-level hook + Raw Input engine, tray, WPF UI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Glideball</RootNamespace>
    <AssemblyName>Glideball</AssemblyName>
    <ApplicationIcon>Assets\Glideball.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glideball.Core\Glideball.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon-256.png" />
    <Resource Include="Assets\Glideball.ico" />
  </ItemGroup>

</Project>
