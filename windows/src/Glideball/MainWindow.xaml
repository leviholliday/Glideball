<Window x:Class="Glideball.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glideball"
        Width="1060" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        Background="{StaticResource WindowFallback}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#12FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,20">
                    <Image Source="pack://application:,,,/Assets/icon-256.png" Width="40" Height="40"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Glideball" FontSize="19" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Faint}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Starting…" FontSize="12" Margin="6,0,0,0"
                                       Foreground="{StaticResource SubText}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,12" Margin="0">
                    <StackPanel>
                        <CheckBox x:Name="EnabledSwitch" Style="{StaticResource Switch}" Content="Glideball on"
                                  Click="EnabledSwitch_Click"/>
                        <TextBlock x:Name="PauseHint" Style="{StaticResource Note}" Margin="0,6,0,0"
                                   Text="Ctrl+Alt+Win+G pauses or resumes from anywhere."/>
                    </StackPanel>
                </Border>

                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Margin="0,0,0,14"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}"/>
                    </ListBox.Resources>
                    <ListBoxItem Content="Overview"/>
                    <ListBoxItem Content="Pointer"/>
                    <ListBoxItem Content="Scrolling"/>
                    <ListBoxItem Content="Buttons"/>
                    <ListBoxItem Content="Apps"/>
                    <ListBoxItem Content="Backup"/>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ContentControl x:Name="PageHost" Margin="32,26,32,32" Focusable="False"/>
        </ScrollViewer>
    </Grid>
</Window>
