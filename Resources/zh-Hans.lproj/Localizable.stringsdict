	<key>Glideball now keeps your records — %lld badges already earned</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>Glideball 现在会保存你的纪录 — 已获得 %lld 枚徽章</string>
		</dict>
	</dict>
